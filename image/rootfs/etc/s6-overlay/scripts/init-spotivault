#!/command/with-contenv sh
# Runs once as root before any service: checks the settings, prepares the folders, then exits.
# Every service after it runs as the unprivileged "app" user. A failed check stops the container.
set -eu

fail() {
    echo "init: $*" >&2
    exit 1
}

# --- Settings -----------------------------------------------------------------------------------

# UMASK applies to /music only (the controller sets it on the recorder). /config stays private.
case "${UMASK:-}" in
    [0-7][0-7][0-7] | [0-7][0-7][0-7][0-7]) ;;
    *) fail "UMASK must be 3 or 4 octal digits, such as 000 or 022 (got '${UMASK:-}')" ;;
esac

# TZ must name a zone in the image's tz database, such as Europe/Berlin.
case "${TZ:-}" in
    "" | /* | *..*) fail "TZ must be a time zone name, such as Europe/Berlin (got '${TZ:-}')" ;;
esac
[ -f "/usr/share/zoneinfo/$TZ" ] || fail "TZ: unknown time zone '$TZ'"

# DEVICE_NAME becomes the client's hostname (see /usr/local/lib/hostname-shim.so), so it must fit
# in one: at most 64 bytes, printable, no "/".
name="${DEVICE_NAME:-}"
[ -n "$name" ] || fail "DEVICE_NAME is empty"
[ "$(printf %s "$name" | wc -c)" -le 64 ] || fail "DEVICE_NAME is longer than 64 bytes"
case "$name" in
    */* | *[[:cntrl:]]*) fail "DEVICE_NAME can't contain '/' or control characters" ;;
esac

# --- /config ------------------------------------------------------------------------------------

# A fresh bind mount belongs to root. Everything in /config belongs to app and stays private:
# it holds the client's login and, later, the Web API tokens.
chown app:app /config
chmod 0700 /config
for d in home logs spotify spytify; do
    [ -d "/config/$d" ] || install -d -o app -g app -m 0700 "/config/$d"
done

# Keep one machine ID for the life of /config, not per container: the client's saved login is
# tied to it. /etc/machine-id links here (set in the image).
if ! grep -Eqx '[0-9a-f]{32}' /config/machine-id 2>/dev/null; then
    tr -d '-' < /proc/sys/kernel/random/uuid > /config/machine-id
    chown app:app /config/machine-id
    chmod 0644 /config/machine-id
    echo "init: new machine ID"
fi

# Chromium (inside the client) locks its profile to "<hostname>-<pid>". A lock left by an earlier
# container makes the client quit at once. Nothing runs yet, so clear it.
rm -f /config/home/.cache/spotify/Singleton*

# --- /music -------------------------------------------------------------------------------------

# Permissions are left to the music folder. The one exception is an empty folder owned by root:
# that's one Docker just created for a bind mount, and app couldn't write to it.
if [ -d /music ] && [ "$(stat -c %u /music)" = 0 ] && [ -z "$(ls -A /music)" ]; then
    chown app:app /music
    echo "init: /music was a new empty folder owned by root; gave it to app"
fi
if ! s6-setuidgid app test -w /music; then
    echo "init: warning: app (uid $(id -u app)) can't write to /music; recordings will fail" >&2
fi

# --- Runtime folders ----------------------------------------------------------------------------

# Sockets for D-Bus, PulseAudio and the recorder.
install -d -o app -g app -m 0700 "$XDG_RUNTIME_DIR" "$XDG_RUNTIME_DIR/pulse"
# X wants this owned by root and sticky.
install -d -o root -g root -m 1777 /tmp/.X11-unix

echo "init: DEVICE_NAME=$name TZ=$TZ UMASK=$UMASK"
